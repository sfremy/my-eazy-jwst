    "import numpy as np\n",
    "from scipy.interpolate import interp1d\n",
    "from scipy.optimize import nnls\n",
    "\n",
    "def load_template_error(file_path):\n",
    "            \"\"\"\n",
    "            Reads the TEF file and returns an interpolation function.\n",
    "            \"\"\"\n",
    "            # Load the wavelength and error columns\n",
    "            # Column 0: Wavelength (A), Column 1: Error amplitude\n",
    "            tef_data = np.loadtxt(file_path)\n",
    "            te_x = tef_data[:, 0]\n",
    "            te_y = tef_data[:, 1]\n",
    "            \n",
    "            # Create an interpolation function. \n",
    "            # Use fill_value to handle wavelengths outside the file's range.\n",
    "            return interp1d(te_x, te_y, kind='linear', bounds_error=False, fill_value=(te_y[0], te_y[-1]))\n",
    "\n",
    "def prepare_and_fit(iobj, fnu_all, efnu_all, filter_pivots_all, tempfilt_all, \n",
    "                    ztry, tempage, tef_interpolator, TEMP_ERR_A2, SYS_ERR,\n",
    "                    OMEGA_L, H0):\n",
    "    \"\"\"\n",
    "    Prepares active arrays for a single object and calls the fitter.\n",
    "    \"\"\"\n",
    "    # 1. Create the Boolean Mask (okfilt)\n",
    "    # Typically: flux > threshold AND error > 0\n",
    "    # Assuming NOT_OBS_THRESHOLD is defined globally (e.g., -90)\n",
    "    okfilt = (fnu_all[iobj] > -90) & (efnu_all[iobj] > 0)\n",
    "    \n",
    "    # 2. Extract Active Data\n",
    "    # These arrays will all have length N_active (e.g., 20)\n",
    "    fnu_active = fnu_all[iobj][okfilt]\n",
    "    efnu_active = efnu_all[iobj][okfilt]\n",
    "    pivots_active = filter_pivots_all[okfilt]\n",
    "    \n",
    "    # In prepare_and_fit, ensure the slice is clean\n",
    "    tempfilt_active = tempfilt_all[:, :, okfilt] \n",
    "    # If tempfilt_all was (NZ, NTEMP, 1, NFILT_TOTAL), \n",
    "    # use .squeeze() to make it (NZ, NTEMP, NFILT_ACTIVE)\n",
    "    tempfilt_active = tempfilt_active.squeeze(axis=2)\n",
    "    \n",
    "    # 4. Call the streamlined fitter\n",
    "    pzall, coeffs = fit_redshift_templates(\n",
    "        iobj, 0, len(ztry), 12, ztry,\n",
    "        tempfilt_active, fnu_active, efnu_active,\n",
    "        pivots_active, tef_interpolator,\n",
    "        TEMP_ERR_A2, SYS_ERR, OMEGA_L, H0, tempage\n",
    "    )\n",
    "    \n",
    "    return pzall, coeffs\n",
    "\n",
    "def fit_redshift_templates(iobj, izspec, NZ_use, NTEMP, ztry, \n",
    "                           tempfilt, fnu_active, efnu_active, \n",
    "                           filter_pivots_active, tef_interpolator,\n",
    "                           TEMP_ERR_A2, SYS_ERR, OMEGA_L, H0,\n",
    "                           tempage=None): # Made tempage optional\n",
    "    \n",
    "    pzall = np.zeros(NZ_use)\n",
    "    coeffs = np.zeros((NZ_use, NTEMP))\n",
    "    SEC_PER_GIGAYEAR = 3.1536e16 \n",
    "\n",
    "    for iz in range(izspec, NZ_use):\n",
    "        z = ztry[iz]\n",
    "\n",
    "        # tempfilt[iz] shape should be (NTEMP, NFILT_ACTIVE)\n",
    "        # We check across axis 1 (the filters)\n",
    "        coverage_mask = np.all(tempfilt[iz] > -90.0, axis=1) # shape: (12,)\n",
    "\n",
    "        if tempage is not None:\n",
    "            # age_univ calculation...\n",
    "            age_mask = (tempage.flatten() < age_univ) # shape: (12,)\n",
    "            combined_mask = coverage_mask & age_mask\n",
    "        else:\n",
    "            combined_mask = coverage_mask\n",
    "\n",
    "        oktemp_idx = np.where(combined_mask)[0] # Will now be a subset of range(0, 12)\n",
    "        \n",
    "        # If no templates are left at this redshift, penalize and move on\n",
    "        if len(oktemp_idx) == 0:\n",
    "            pzall[iz] = 9.99e30\n",
    "            continue\n",
    "\n",
    "        # --- Math Block ---\n",
    "        l_rest = filter_pivots_active / (1 + z)\n",
    "\n",
    "        # Ensure te and inv_sigma are 1D arrays (length N_active)\n",
    "        te = tef_interpolator(l_rest).flatten() \n",
    "        sigi2 = (SYS_ERR**2 + te**2) * (fnu_active**2) + (efnu_active**2)\n",
    "        inv_sigma = 1.0 / np.sqrt(sigi2)\n",
    "\n",
    "        A = tempfilt[iz, oktemp_idx, :].T\n",
    "        # inv_sigma is (N_active,) e.g., (24,)\n",
    "        # We use [:, np.newaxis] on inv_sigma to make it (24, 1) for broadcasting\n",
    "        A_weighted = A * inv_sigma[:, np.newaxis]\n",
    "        y_weighted = fnu_active * inv_sigma\n",
    "\n",
    "        # NNLS solver\n",
    "        solution_coeffs, rnorm = nnls(A_weighted, y_weighted)\n",
    "\n",
    "        pzall[iz] = rnorm**2\n",
    "        # Place the results back into the correct template slots\n",
    "        coeffs[iz, oktemp_idx] = solution_coeffs\n",
    "\n",
    "    return pzall, coeffs\n",
    "\n",
    "def cosmotl(z, omega_l):\n",
    "    \"\"\"Placeholder for the cosmological lookback time function.\"\"\"\n",
    "    # Implement actual cosmology integration here\n",
    "    if z <= 0:\n",
    "        return 1\n",
    "    else:\n",
    "        return (np.arcsinh((1.0 + z)**(-1.5) * np.sqrt(omega_l / (1.0 - omega_l))) / \n",
    "              np.arcsinh(np.sqrt(omega_l / (1.0 - omega_l))))"
