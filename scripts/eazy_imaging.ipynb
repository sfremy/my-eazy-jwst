    "import matplotlib.pyplot as plt\n",
    "\n",
    "def read_eazy_binary_pz(filename, iobj):\n",
    "    \"\"\"\n",
    "    Reads the chi-squared values for a specific object from an EAZY .pz file.\n",
    "    \"\"\"\n",
    "    with open(filename, 'rb') as f:\n",
    "        # Read header: usually N_OBJECTS (int32), N_Z (int32), Z_STEP (float32), etc.\n",
    "        # This structure varies slightly by version; assuming standard binary:\n",
    "        n_obj = np.fromfile(f, dtype=np.int32, count=1)[0]\n",
    "        n_z = np.fromfile(f, dtype=np.int32, count=1)[0]\n",
    "        z_grid = np.fromfile(f, dtype=np.float32, count=n_z)\n",
    "        \n",
    "        # Seek to the specific object's data (iobj is 0-indexed)\n",
    "        # Each object has n_z float32 values\n",
    "        offset = 8 + (n_z * 4) + (iobj * n_z * 4)\n",
    "        f.seek(offset)\n",
    "        chi2_vals = np.fromfile(f, dtype=np.float32, count=n_z)\n",
    "        \n",
    "    return z_grid, chi2_vals\n",
    "\n",
    "def plot_comparison(z_grid, chi2_mine, chi2_eazy):\n",
    "    # Convert Chi2 to Probability: P(z) ~ exp(-0.5 * chi2)\n",
    "    # We subtract min(chi2) to prevent underflow/numerical issues\n",
    "    p_mine = np.exp(-0.5 * (chi2_mine - np.min(chi2_mine)))\n",
    "    p_eazy = np.exp(-0.5 * (chi2_eazy - np.min(chi2_eazy)))\n",
    "    \n",
    "    # Normalize\n",
    "    p_mine /= np.trapz(p_mine, z_grid)\n",
    "    p_eazy /= np.trapz(p_eazy, z_grid)\n",
    "\n",
    "    plt.figure(figsize=(10, 5))\n",
    "    plt.plot(z_grid, p_eazy, label='Original EAZY', lw=3, alpha=0.5, color='gray')\n",
    "    plt.plot(z_grid, p_mine, label='Your Python Code', ls='--', color='red')\n",
    "    plt.xlabel('Redshift (z)')\n",
    "    plt.ylabel('P(z)')\n",
    "    plt.title('Validation: P(z) Comparison')\n",
    "    plt.legend()\n",
    "    plt.show()"
   ]
