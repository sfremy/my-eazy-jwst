    "def build_tempfilt_vectorized(ztry, sed_list, filters):\n",
    "    NZ = len(ztry)\n",
    "    NTEMP = len(sed_list)\n",
    "    NFILT = len(filters)\n",
    "    tempfilt = np.zeros((NZ, NTEMP, NFILT))\n",
    "\n",
    "    for ifilt in range(NFILT):\n",
    "        w_filt, t_filt = filters[ifilt][0], filters[ifilt][1]\n",
    "        \n",
    "        # 1. Standard EAZY Fnu normalization: Integral of (T / lambda) dlambda\n",
    "        # This matches the unit conversion logic for F_lambda to F_nu\n",
    "        norm = np.trapz(t_filt / w_filt, w_filt)\n",
    "        \n",
    "        # 2. Create a 2D grid of rest-frame wavelengths: (NZ, N_filter_points)\n",
    "        # w_rest[iz, :] is the rest-frame wavelength for that filter at redshift z\n",
    "        w_rest = w_filt[None, :] / (1 + ztry)[:, None]\n",
    "        \n",
    "        for itemp in range(NTEMP):\n",
    "            w_sed, f_sed = sed_list[itemp]\n",
    "            \n",
    "            # 3. Interpolate the SED onto the 2D w_rest grid\n",
    "            # sed_interp shape: (NZ, N_filter_points)\n",
    "            sed_interp = np.interp(w_rest.flatten(), w_sed, f_sed, left=0, right=0)\n",
    "            sed_interp = sed_interp.reshape(NZ, -1)\n",
    "            \n",
    "            # 4. Numerator: Integral(F_lambda * T * lambda) dlambda\n",
    "            # This is done for all redshifts at once for this template\n",
    "            # Resulting 'num' has shape (NZ,)\n",
    "            integrand = sed_interp * t_filt * w_filt\n",
    "            num = np.trapz(integrand, w_filt, axis=1)\n",
    "            \n",
    "            tempfilt[:, itemp, ifilt] = num / norm\n",
    "            \n",
    "        print(f'Filter {ifilt+1}/{NFILT} processed.')\n",
    "\n",
    "    return tempfilt"
   ]
  },
